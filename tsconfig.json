{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Lets the pure modules that tests/*.test.mjs imports through Node's type
    // stripping name their siblings with the .ts extension Node requires. Safe
    // with noEmit: the bundler resolves the same files either way.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // Imports the OpenNext-generated .open-next/worker.js, which only exists
    // after `opennextjs-cloudflare build`; wrangler bundles it independently.
    "worker.ts",
    ".open-next",
    // Separate Worker project (own package.json/tsconfig): see tiles-worker/README.md
    "tiles-worker",
    // Mobile: static export + native projects (Capacitor)
    "out",
    "ios",
    "android"
  ]
}
