# Copy to .dev.vars (gitignored) for `pnpm cf:preview` local runs.
# In production set these with `npx wrangler secret put <NAME>` instead.

# Admin panel login (see src/lib/auth.ts)
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Bearer token the cron/refresh routes require (worker.ts sends it)
CRON_SECRET=change-me-three

# NOTE: gauge snapshots + analytics use the DATA_BUCKET R2 binding on
# Cloudflare (simulated locally by `pnpm cf:preview`) — no token needed.
# BLOB_READ_WRITE_TOKEN is only for the Vercel/Docker deploy targets.
