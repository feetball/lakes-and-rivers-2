# eslint-config-next bundles its own plugins (react, react-hooks, import,
# jsx-a11y, @next/eslint-plugin-next). pnpm's isolated node_modules hides them
# from ESLint's plugin resolver, so hoist anything ESLint-related to the root.
public-hoist-pattern[]=*eslint-plugin*
public-hoist-pattern[]=@next/eslint-plugin-next
public-hoist-pattern[]=@rushstack/eslint-patch
public-hoist-pattern[]=@typescript-eslint/*
