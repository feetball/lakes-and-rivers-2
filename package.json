{
  "name": "texas-flood-map",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/build-waterways-data.mjs",
    "data:build:refresh": "node scripts/build-waterways-data.mjs --refresh",
    "data:refresh-list": "node scripts/refresh-gauges-list.mjs",
    "data:cache:clear": "rm -rf data-cache/gauges",
    "data:cache:pack": "node scripts/pack-cache.mjs",
    "data:cache:unpack": "node scripts/unpack-cache.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:export": "node scripts/build-mobile.mjs --no-sync",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#0b1220\" --iconBackgroundColorDark \"#0b1220\" --splashBackgroundColor \"#0b1220\" --splashBackgroundColorDark \"#0b1220\"",
    "prebuild": "node scripts/build-waterways-data.mjs --if-missing",
    "release": "pnpm version patch -m \"chore(release): %s\" && git push --follow-tags"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@opennextjs/cloudflare": "^1.20.1",
    "@vercel/blob": "^2.5.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/eslintrc": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.19",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.111.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
