{
  "name": "texas-flood-map",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "start": "node .next/standalone/server.js",
    "postbuild": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/build-waterways-data.mjs",
    "data:build:refresh": "node scripts/build-waterways-data.mjs --refresh",
    "data:refresh-list": "node scripts/refresh-gauges-list.mjs",
    "data:cache:clear": "rm -rf data-cache/gauges",
    "data:cache:pack": "node scripts/pack-cache.mjs",
    "data:cache:unpack": "node scripts/unpack-cache.mjs",
    "prebuild": "node scripts/build-waterways-data.mjs --if-missing",
    "release": "pnpm version patch -m \"chore(release): %s\" && git push --follow-tags",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@vercel/blob": "^2.5.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.19",
    "typescript": "^5.7.3",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
