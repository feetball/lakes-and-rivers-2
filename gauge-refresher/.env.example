# Copy to .env and fill in. The gauge-refresher container reads these.

# PREFERRED: ingest mode. The container fetches NWPS itself (no time limit) and
# pushes the result to the app's ingest endpoint. This is the only mode that
# reliably delivers LIVE data — the slow NWPS fetch can't fit inside Vercel's
# 60 s function cap, so the legacy ping mode (REFRESH_URL) just 504s.
INGEST_URL=https://your-app.example.com/api/gauges/ingest

# LEGACY: ping mode. Leave INGEST_URL blank and set this to fall back to the
# old behavior (ping /api/cron/refresh-gauges and let the app fetch NWPS).
# REFRESH_URL=https://your-app.example.com/api/cron/refresh-gauges

# Must equal the CRON_SECRET set on the main app. Required for ingest (the
# ingest endpoint refuses writes unless a secret is configured and matches).
CRON_SECRET=

# OPTIONAL: a second deployment pinged on every tick in addition to the
# primary above (e.g. a Cloudflare Workers copy of the app). Off unless set.
# SECONDARY_REFRESH_URL=https://your-app.example.workers.dev/api/cron/refresh-gauges
# SECONDARY_CRON_SECRET=

# Optional overrides:
# NWPS_URL=https://api.water.noaa.gov/nwps/v1/gauges?state=TX
# CRON_SCHEDULE=*/10 * * * *
# CURL_TIMEOUT=120
# TZ=America/Chicago
