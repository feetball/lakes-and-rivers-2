# Copy to .env and fill in. The gauge-refresher container reads these.

# Full URL of the main app's cron refresh endpoint.
# If the main app runs on this same Docker host, you can use its container name
# (e.g. http://texas-flood-map:3000/...) once both share a network; otherwise
# use the public/LAN URL.
REFRESH_URL=https://your-app.example.com/api/cron/refresh-gauges

# Must equal the CRON_SECRET set on the main app. If the app has no CRON_SECRET,
# leave this blank and the endpoint will accept unauthenticated requests.
CRON_SECRET=

# Optional overrides:
# CRON_SCHEDULE=*/10 * * * *
# CURL_TIMEOUT=90
# TZ=America/Chicago
